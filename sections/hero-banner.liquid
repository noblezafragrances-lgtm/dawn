<div
  class="hero-banner{% if section.settings.image == blank %} no-image{% endif %}"
  {% if section.settings.image != blank %}
    style="background-image:url('{{ section.settings.image | image_url: width: 1600 }}');"
  {% endif %}
>
  <div class="hero-content">
    <div class="hero-eyebrow">{{ section.settings.eyebrow | default: 'New Arrivals' }}</div>
    <div class="hero-title">{{ section.settings.heading | default: 'Discover Your Signature Scent' }}</div>
    {% if section.settings.button_label != blank %}
      <a href="{{ section.settings.button_url }}" class="hero-cta">{{ section.settings.button_label }}</a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "New Arrivals" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover Your Signature Scent" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop Now" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [
    { "name": "Hero banner" }
  ]
}
{% endschema %}
