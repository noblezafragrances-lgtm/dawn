<header class="site-header">
  <div class="header-row">

    <button class="mobile-nav-toggle" aria-label="Open menu" onclick="document.getElementById('mobileDrawer').classList.add('open')">
      <svg class="icon" viewBox="0 0 24 24"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>

    <a href="{{ routes.root_url }}" class="site-logo" id="siteLogo" aria-label="{{ shop.name }} — home">
      <div class="logo-nozzle"></div>
      <div class="logo-mist"></div>
      <div class="logo-mist"></div>
      <div class="logo-mist"></div>
      <div class="logo-mist"></div>
      <div class="logo-mist"></div>
      {{ shop.name | upcase }}
    </a>

    <nav class="main-nav">
      <ul style="display:flex; gap:34px; list-style:none; margin:0; padding:0;">
        {% for link in linklists.main-menu.links %}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
            {% if link.links != blank %}
              <div class="mega-menu">
                {% for childlink in link.links %}
                  <div class="mega-col">
                    <h4>{{ childlink.title }}</h4>
                    {% if childlink.links != blank %}
                      {% for grandchild in childlink.links %}
                        <a href="{{ grandchild.url }}">{{ grandchild.title }}</a>
                      {% endfor %}
                    {% endif %}
                  </div>
                {% endfor %}
              </div>
            {% endif %}
          </li>
        {% endfor %}
      </ul>
    </nav>

    <form action="{{ routes.search_url }}" method="get" class="header-search" role="search">
      <svg class="icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <input type="text" name="q" placeholder="Search fragrances, brands...">
    </form>

    <div class="header-icons">
      <a href="{{ routes.account_url }}" aria-label="Account">
        <svg class="icon" viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <a href="{{ routes.account_url }}/wishlist" aria-label="Wishlist">
        <svg class="icon" viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" aria-label="Cart ({{ cart.item_count }} items)">
        <svg class="icon" viewBox="0 0 24 24"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
      </a>
    </div>

  </div>
</header>

<!-- MOBILE DRAWER (Macy's-style hamburger menu, no bottom nav bar) -->
<div class="mobile-drawer" id="mobileDrawer">
  <div class="drawer-top">
    <div class="site-logo">MENU</div>
    <button aria-label="Close menu" style="background:none;border:none;" onclick="document.getElementById('mobileDrawer').classList.remove('open')">
      <svg class="icon" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  {% for link in linklists.main-menu.links %}
    <a href="{{ link.url }}" class="drawer-link">{{ link.title }}</a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Header",
  "settings": [],
  "presets": [
    { "name": "Header" }
  ]
}
{% endschema %}
