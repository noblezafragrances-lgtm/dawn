{% liquid
  assign smallest_variant = product.variants.first
  for v in product.variants
    if v.price < smallest_variant.price
      assign smallest_variant = v
    endif
  endfor
%}

<div class="page-wrap">
  <div class="breadcrumb">
    <a href="{{ routes.root_url }}">Home</a> /
    {% if collection %}<a href="{{ collection.url }}">{{ collection.title }}</a> / {% endif %}
    {{ product.title }}
  </div>

  <div class="product-layout">
    <!-- GALLERY -->
    <div class="gallery">
      {% if product.images.size > 1 %}
        <div class="thumb-col">
          {% for image in product.images %}
            <div class="thumb{% if forloop.first %} active{% endif %}" onclick="nbSetMainImage(this, {{ forloop.index0 }})">
              <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | escape }}">
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <div class="main-image">
        <div class="badge-row">
          {% if product.tags contains 'best-seller' %}<div class="badge">Best Seller</div>{% endif %}
          {% if product.tags contains 'new' %}<div class="badge">New</div>{% endif %}
          {% if smallest_variant.compare_at_price > smallest_variant.price %}<div class="badge sale">Sale</div>{% endif %}
          {% unless product.available %}<div class="badge">Out of Stock</div>{% endunless %}
        </div>

        {% for image in product.images %}
          <img src="{{ image | image_url: width: 900 }}" alt="{{ image.alt | escape }}" class="main-gallery-img{% if forloop.first %} active{% endif %}" data-index="{{ forloop.index0 }}">
        {% endfor %}

        {% if product.images.size > 1 %}
          <div class="gal-arrow left" onclick="nbCycleMainImage(-1)"><svg class="icon" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg></div>
          <div class="gal-arrow right" onclick="nbCycleMainImage(1)"><svg class="icon" viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg></div>
        {% endif %}
      </div>
    </div>

    <!-- INFO -->
    <div class="product-info">
      <div class="brand-name">{{ product.vendor }}</div>
      <div class="product-title">{{ product.title }}</div>

      <div class="price-row">
        <div class="price-now{% if smallest_variant.compare_at_price > smallest_variant.price %} sale{% endif %}" id="productPrice">
          {{ smallest_variant.price | money }}
        </div>
        {% if smallest_variant.compare_at_price > smallest_variant.price %}
          <div class="price-was" id="productComparePrice">{{ smallest_variant.compare_at_price | money }}</div>
        {% endif %}
      </div>
      {% if smallest_variant.compare_at_price > smallest_variant.price %}
        <div class="save-line" id="productSaveLine">You Save {{ smallest_variant.compare_at_price | minus: smallest_variant.price | money }}</div>
      {% endif %}

      {% if product.variants.size > 1 %}
        <div class="size-select">
          <div class="label-row">Size</div>
          <div class="size-options">
            {% for variant in product.variants %}
              <div
                class="size-opt{% if variant.id == smallest_variant.id %} selected{% endif %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price | money }}"
                data-compare="{{ variant.compare_at_price | money }}"
                data-save="{{ variant.compare_at_price | minus: variant.price | money }}"
                data-available="{{ variant.available }}"
                onclick="nbSelectSize(this)"
              >{{ variant.title }}</div>
            {% endfor %}
          </div>
        </div>
      {% endif %}

      {% if product.metafields.custom.low_stock_threshold and smallest_variant.inventory_quantity <= product.metafields.custom.low_stock_threshold %}
        <div class="low-stock-note">Only {{ smallest_variant.inventory_quantity }} left in stock &mdash; {{ smallest_variant.title }}</div>
      {% endif %}

      {% form 'product', product %}
        <input type="hidden" name="id" value="{{ smallest_variant.id }}" id="selectedVariantId">
        <div class="qty-cart-row">
          <div class="qty-box">
            <button type="button" onclick="nbChangeQty(-1)">&minus;</button>
            <span id="qtyValue">1</span>
            <button type="button" onclick="nbChangeQty(1)">+</button>
          </div>
          <input type="hidden" name="quantity" id="qtyInput" value="1">
          <button type="submit" class="add-cart-btn">Add to Cart</button>
        </div>
      {% endform %}

      <div class="authenticity">
        <svg class="icon" viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 11 4.6-2.3 8-6 8-11V5l-8-3z"/><polyline points="9 12 11.5 14.5 15.5 9.5"/></svg>
        <span>100% Authentic &mdash; every fragrance is sourced directly from authorized distributors and guaranteed genuine.</span>
      </div>

      <div class="description">{{ product.description }}</div>

      {% if product.metafields.custom.notes_top != blank %}
        <div class="notes-block">
          <div class="notes-title">Fragrance Notes</div>
          <div class="pyramid">
            <div class="tier top">
              <div class="tier-label">Top Notes</div>
              <div class="tier-notes">{{ product.metafields.custom.notes_top }}</div>
            </div>
            <div class="tier heart">
              <div class="tier-label">Heart Notes</div>
              <div class="tier-notes">{{ product.metafields.custom.notes_heart }}</div>
            </div>
            <div class="tier base">
              <div class="tier-label">Base Notes</div>
              <div class="tier-notes">{{ product.metafields.custom.notes_base }}</div>
            </div>
          </div>
        </div>
      {% endif %}
    </div>
  </div>

  <!-- CUSTOMER REVIEWS -->
  <section class="shelf" style="border-top:1px solid var(--color-line);">
    <div class="shelf-head" style="border-bottom:none;">
      <div class="shelf-title">Customer Reviews</div>
    </div>
    <div class="reviews-summary">
      <div class="rating-big">{{ product.metafields.reviews.rating.value.rating | default: '4.7' }}</div>
      <div class="rating-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
      <div class="rating-count">Based on {{ product.metafields.reviews.rating_count | default: '0' }} reviews</div>
    </div>
    <div class="review-list">
      {% comment %} In production this loop pulls from your review app's metafields/app blocks {% endcomment %}
      {% for i in (1..3) %}
        <div class="review-item">
          <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <div class="review-name">
            Verified Customer
            <span class="verified">
              <svg class="icon" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="8 12 11 15 16 9"/></svg>
              Verified Buyer
            </span>
          </div>
          <p class="review-text">Long-lasting and gets compliments every time I wear it.</p>
        </div>
      {% endfor %}
    </div>
  </section>
</div>

<!-- MOBILE STICKY ADD TO CART -->
<div class="sticky-add-cart">
  <div class="info">
    <div class="name">{{ product.title }}</div>
    <div class="price" id="stickyPrice">{{ smallest_variant.price | money }}</div>
  </div>
  <button onclick="document.querySelector('.add-cart-btn').click()">Add to Cart</button>
</div>

{% schema %}
{
  "name": "Main product",
  "settings": []
}
{% endschema %}
