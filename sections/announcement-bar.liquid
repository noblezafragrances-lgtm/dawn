<div class="announce-bar">{{ section.settings.announce_text | default: 'Free shipping over $75+ USD' }}</div>

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "text",
      "id": "announce_text",
      "label": "Announcement text",
      "default": "Free shipping over $75+ USD"
    }
  ],
  "presets": [
    { "name": "Announcement bar" }
  ]
}
{% endschema %}
