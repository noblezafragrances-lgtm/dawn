<div class="category-tabs">
  {% for block in section.blocks %}
    <a class="category-tab" href="{{ block.settings.url }}">{{ block.settings.label }}</a>
  {% endfor %}
</div>

{% schema %}
{
  "name": "Category tabs",
  "settings": [],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Niche" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Category tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Niche" } },
        { "type": "tab", "settings": { "label": "Arabic" } },
        { "type": "tab", "settings": { "label": "Designer" } },
        { "type": "tab", "settings": { "label": "Unisex" } }
      ]
    }
  ]
}
{% endschema %}