<footer class="site-footer">
  <div class="footer-top">
    <div class="footer-col">
      <h5>Join the List</h5>
      <p style="font-size:13px; color:#b3b3b3; line-height:1.5;">Sign up for early access to new arrivals and offers.</p>
      {% form 'customer' %}
        <div class="newsletter-form">
          <input type="email" name="contact[email]" placeholder="Email address" required>
          <button type="submit">Sign Up</button>
        </div>
      {% endform %}
      <div class="social-row">
        {% if settings.social_instagram_link != blank %}
          <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">
            <svg class="icon" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
          </a>
        {% endif %}
        {% if settings.social_tiktok_link != blank %}
          <a href="{{ settings.social_tiktok_link }}" aria-label="TikTok">
            <svg class="icon" viewBox="0 0 24 24"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
          </a>
        {% endif %}
        {% if settings.social_facebook_link != blank %}
          <a href="{{ settings.social_facebook_link }}" aria-label="Facebook">
            <svg class="icon" viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        {% endif %}
      </div>
    </div>

    <div class="footer-col">
      <h5>Shop</h5>
      {% for link in linklists.footer-shop.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>

    <div class="footer-col">
      <h5>Help</h5>
      {% for link in linklists.footer-help.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>

    <div class="footer-col">
      <h5>Company</h5>
      {% for link in linklists.footer-company.links %}
        <a href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    </div>
  </div>

  <div class="footer-bottom">
    <span>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</span>
    <span>Visa &middot; Mastercard &middot; Amex &middot; Shop Pay &middot; PayPal</span>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [
    { "name": "Footer" }
  ]
}
{% endschema %}
